      },
      {
        "id": "73f36d68-4287-4a4f-855e-f4d642e5f219",
        "sender_id": "469047d3-53b7-4f24-9cb0-73ba2f76047e",
        "receiver_id": "32614a63-db0c-4325-b100-c01e49da9772",
        "content": "Hey Ahmed! I just got my Beagle puppy Charlie. Any tips?",
        "is_read": false,
        "created_at": "2026-05-20T09:11:08.680Z"
      },
      {
        "id": "1d2c1dae-21e8-416a-83b6-718e032bd677",
        "sender_id": "32614a63-db0c-4325-b100-c01e49da9772",
        "receiver_id": "469047d3-53b7-4f24-9cb0-73ba2f76047e",
        "content": "Congrats Omar! Be patient with training and keep treats handy — Beagles are very food motivated 😄",
