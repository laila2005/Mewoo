        "receiver_id": "4b5d94d8-9987-4d51-8109-e31a4950515f",
        "content": "Hi Sara! Is she eating normally? Any discharge from the nose or eyes?",
        "is_read": false,
        "created_at": "2026-05-20T09:11:09.061Z"
      },
      {
        "id": "722f2a6b-1da9-4b07-baa7-063bf44e581e",
