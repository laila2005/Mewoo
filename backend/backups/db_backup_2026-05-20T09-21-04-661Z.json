        "created_at": "2026-05-20T09:11:08.757Z"
      },
      {
        "id": "1ca0a529-cfcd-4fe0-98a8-5ac2ae05a127",
        "sender_id": "469047d3-53b7-4f24-9cb0-73ba2f76047e",
        "receiver_id": "32614a63-db0c-4325-b100-c01e49da9772",
