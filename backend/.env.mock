# Keyless local run: forces the offline mock LLM provider.
# Loaded via `npm run dev:mock` (node --env-file). Values here win over .env,
# because dotenv.config() never overrides an already-set process.env var.
# Contains no secrets - DATABASE_URL and friends still come from .env.
AI_PROVIDER=mock

# Blank SMTP => emailService falls back to its terminal sandbox logger, so
# local testing against the production database can never mail a real user.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
